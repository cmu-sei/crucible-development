<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);ASPIRECERTIFICATES001</NoWarn>
    <!-- WithTags is experimental in Aspire 17 -->
    <NoWarn>$(NoWarn);ASPIRERESOURCETRAITS001</NoWarn>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- DCP and the dashboard come from the installed Aspire CLI, so keep the CLI pin in
         .devcontainer/devcontainer.json on the same version as the Aspire packages below -->
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <UserSecretsId>98efcc77-ed92-4f61-8c56-50f0fbbb7eb2</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.JavaScript" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Keycloak" Version="17.0.0-preview.1.26567.5" />
    <PackageReference Include="Aspire.Hosting.MySql" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Redis" Version="17.0.0" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.15" />
  </ItemGroup>

</Project>
