# Copy with configure-hypervisors.sh init, then replace <placeholders>.
# Literal KEY=value: no shell quoting, expansion or inline comments.
# Certificate validation is disabled here for local development only.
#
# The token is an API secret (it matches Terraform:Secrets:Patterns, ^CASTER_SECRET_):
# it reaches only the projects the seeded "Proxmox" Environment Set is assigned to.
# Assign it in Caster under Administration > Environment Sets.
CASTER_SECRET_PROXMOX_VE_API_TOKEN=<user@realm!token-id=token-secret>
#
# Created at startup if no set is named "Proxmox"; an existing set is never changed.
# After editing these lines, delete the set in Caster and restart to seed it again.
SeedData__EnvironmentSets__0__Name=Proxmox
SeedData__EnvironmentSets__0__Description=Proxmox provider credentials from the crucible-development API profile
SeedData__EnvironmentSets__0__Entries__0__TargetName=PROXMOX_VE_ENDPOINT
SeedData__EnvironmentSets__0__Entries__0__Value=https://<proxmox-host>:<proxmox-port>
SeedData__EnvironmentSets__0__Entries__1__TargetName=PROXMOX_VE_INSECURE
SeedData__EnvironmentSets__0__Entries__1__Value=true
SeedData__EnvironmentSets__0__Entries__2__TargetName=PROXMOX_VE_API_TOKEN
SeedData__EnvironmentSets__0__Entries__2__ValueSource=Secret
SeedData__EnvironmentSets__0__Entries__2__SecretName=CASTER_SECRET_PROXMOX_VE_API_TOKEN
#
# Inventory: lists this Proxmox's templates, ISOs, networks, storage and nodes in Caster's
# Infrastructure panel. Caster never passes Infrastructure__ settings to Terraform runs.
Infrastructure__Connections__0__Name=proxmox
Infrastructure__Connections__0__Provider=proxmox
Infrastructure__Connections__0__Url=https://<proxmox-host>:<proxmox-port>
Infrastructure__Connections__0__ApiToken=<user@realm!token-id=token-secret>
Infrastructure__Connections__0__InsecureSkipVerify=true
Infrastructure__Connections__0__IsoLocations__0=<iso-storage>
Infrastructure__Connections__0__Inventory__Enabled=true
