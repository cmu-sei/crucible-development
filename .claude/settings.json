{
  "env": {
    "CLAUDE_CODE_USE_BEDROCK": "1",
    "AWS_REGION": "us-east-1",
    "AWS_PROFILE": "default"
  },
  "permissions": {
    "allow": [
      "mcp__playwright-test__*"
    ],
    "ask": [
      "Bash(gh api *-X P*rulesets*)",
      "Bash(gh api *rulesets*-X P*)",
      "Bash(gh api *rulesets* -f *)",
      "Bash(gh api *rulesets* -F *)",
      "Bash(gh api *rulesets*--input*)",
      "Bash(gh api *-X P*protection*)",
      "Bash(gh api *protection*-X P*)",
      "Bash(gh api *protection* -f *)",
      "Bash(gh api *protection* -F *)",
      "Bash(gh api *protection*--input*)",
      "Bash(gh api *-X P*collaborators*)",
      "Bash(gh api *collaborators*-X P*)",
      "Bash(gh api *collaborators* -f *)",
      "Bash(gh api *collaborators* -F *)",
      "Bash(gh api *collaborators*--input*)",
      "Bash(gh api *-X P*hooks*)",
      "Bash(gh api *hooks*-X P*)",
      "Bash(gh api *hooks* -f *)",
      "Bash(gh api *hooks* -F *)",
      "Bash(gh api *hooks*--input*)",
      "Bash(gh api *-X P*keys*)",
      "Bash(gh api *keys*-X P*)",
      "Bash(gh api *keys* -f *)",
      "Bash(gh api *keys* -F *)",
      "Bash(gh api *keys*--input*)",
      "Bash(gh api *-X P*actions/permissions*)",
      "Bash(gh api *actions/permissions*-X P*)",
      "Bash(gh api *actions/permissions* -f *)",
      "Bash(gh api *actions/permissions* -F *)",
      "Bash(gh api *actions/permissions*--input*)",
      "Bash(gh api *-X P*alerts*)",
      "Bash(gh api *alerts*-X P*)",
      "Bash(gh api *alerts* -f *)",
      "Bash(gh api *alerts* -F *)",
      "Bash(gh api *alerts*--input*)",
      "Bash(gh api *security_and_analysis[*)"
    ],
    "deny": [
      "Bash(gh api *-X DELETE*)",
      "Bash(gh api *-XDELETE*)",
      "Bash(gh api *-X delete*)",
      "Bash(gh api *-Xdelete*)",
      "Bash(gh api *--method DELETE*)",
      "Bash(gh api *--method=DELETE*)",
      "Bash(gh api *--method delete*)",
      "Bash(gh api *--method=delete*)",
      "Bash(gh api *mutation*delete*)",
      "Bash(gh api *mutation*archive*)",
      "Bash(gh api *mutation*transfer*)",
      "Bash(gh api *mutation*force*)",
      "Bash(gh api *repos/*/transfer*)",
      "Bash(gh api * -f visibility=*)",
      "Bash(gh api * -F visibility=*)",
      "Bash(gh api * -f private=*)",
      "Bash(gh api * -F private=*)",
      "Bash(gh api * -f archived=*)",
      "Bash(gh api * -F archived=*)",
      "Bash(gh api *git/refs* -f force=true*)",
      "Bash(gh api *git/refs* -F force=true*)",
      "Bash(gh api *actions/runs/*cancel*)",
      "Bash(gh api *actions/workflows/*/disable*)",
      "Bash(gh alias delete *)",
      "Bash(gh auth logout *)",
      "Bash(gh cache delete *)",
      "Bash(gh codespace delete *)",
      "Bash(gh codespace rebuild *)",
      "Bash(gh config clear-cache *)",
      "Bash(gh extension remove *)",
      "Bash(gh gist delete *)",
      "Bash(gh gpg-key delete *)",
      "Bash(gh issue delete *)",
      "Bash(gh issue transfer *)",
      "Bash(gh label delete *)",
      "Bash(gh project close *)",
      "Bash(gh project delete *)",
      "Bash(gh project field-delete *)",
      "Bash(gh project item-delete *)",
      "Bash(gh project item-archive *)",
      "Bash(gh release delete *)",
      "Bash(gh release delete-asset *)",
      "Bash(gh repo archive *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo deploy-key delete *)",
      "Bash(gh repo rename *)",
      "Bash(gh repo transfer *)",
      "Bash(gh repo unarchive *)",
      "Bash(gh repo visibility *)",
      "Bash(gh run cancel *)",
      "Bash(gh run delete *)",
      "Bash(gh secret delete *)",
      "Bash(gh ssh-key delete *)",
      "Bash(gh variable delete *)",
      "Bash(gh workflow disable *)"
    ],
    "additionalDirectories": [
      "/mnt/data/crucible"
    ]
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true
  }
}
