# RangerAI + Keycloak supplies realm settings for RangerAI versions that support login.
# Realm: https://localhost:8443/realms/crucible (admin/admin). Clients: chronicle.ui (4320),
# chronicle.api (5285), scenario-builder.ui (4330), scenario-builder.api (5280), with
# audience scopes chronicle and scenario-builder. On the published version without login,
# Scenario Builder uses its default local administrator, dev.
Launch__RangerAI=true
Launch__RangerAIKeycloak=true
