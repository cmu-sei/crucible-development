# RangerAI + Keycloak Task - RangerAI's apps wait for Keycloak, for adding a Keycloak login.
# Realm: https://localhost:8443/realms/crucible (admin/admin). Clients: chronicle.ui (4320),
# chronicle.api (5285), scenario-builder.ui (4330), scenario-builder.api (5280), with
# audience scopes chronicle and scenario-builder. Scenario Builder requires a Keycloak login
# (Keycloak's admin user is its admin); Chronicle doesn't use it yet.
Launch__RangerAI=true
Launch__RangerAIKeycloak=true
