# Sign in to Chronicle (4320) and Scenario Builder (4330) through the crucible realm.
# The development account admin/admin can manage Scenario Builder. Scenario Builder
# uses its own scenario-builder.service account to publish to Chronicle.
# GraySpace runs with them (UI :3000, API :8010), with its own sign-in: admin, builder or user,
# password grayspace-dev. It has no Keycloak login yet.
Launch__RangerAI=true
Launch__RangerAIKeycloak=true
