# Moodle 5.2 Task - Moodle 5.2 test instance enabled with Xdebug off
# Runs alongside the 5.0 instance on port 8082 with its own database (moodle52),
# so neither one upgrades the other's schema.
# Note: Add supporting apps (Player, Gallery, CITE, Steamfitter, etc.) to appsettings.Development.json under Launch.Prod or Launch.Dev
Launch__Moodle52=true
Launch__XdebugMode=off
