# All Apps (Stopped) Task - Registers every application in the Aspire dashboard
# in an explicit-start (stopped) state. Postgres and Keycloak still start since
# every app depends on them; each application resource must be started manually
# from the dashboard as the developer chooses.
# Set Launch:DefaultUiMode to dev or prod in appsettings.Development.json
# to choose Angular dev-server or static hosting when starting an unselected app.
Launch__AddAllApplications=true
