# RangerAI Task - Chronicle (API :5285, UI :4320) and Scenario Builder (API :5280, UI :4330)
# Each API uses its default SQLite database. The AppHost also starts shared Postgres and Keycloak.
# This profile leaves RangerAI sign-in off.
# GraySpace runs with them, simulated (no Proxmox): UI :3000 (admin, builder or user, password
# grayspace-dev), API :8010 (/control/docs), Prometheus :9090, simulated router metrics :9342.
Launch__RangerAI=true
