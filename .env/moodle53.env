# Moodle 5.3 Task - Moodle 5.3 test instance enabled with Xdebug off
# Runs alongside the 5.0 and 5.2 instances on port 8083 with its own database (moodle53),
# so none of them upgrades another's schema.
# Note: Add supporting apps (Player, Gallery, CITE, Steamfitter, etc.) to appsettings.Development.json under Launch.Prod or Launch.Dev
Launch__Moodle53=true
Launch__XdebugMode=off
