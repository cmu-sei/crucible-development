<!--
  The pinned test packages of the Crucible API test standard (agent-docs/api-testing). Not copied: sync.sh
  checks that the repository's Directory.Packages.props declares each of these at exactly this version
  (or, in a repository without central package management, that the test project references each at this
  version). Change a version here first, prove it on the pilot, then roll it out. A package marked
  Optional="true" is not required; where a test project references it, it is at exactly this version.
-->
<Project>
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <!-- Hosts the application in process. Tied to ASP.NET Core 10.0; moves with the framework patch. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.1" />
    <!-- The SignalR client for a hub's real-connection test (CONVENTIONS.md section 1). Optional until
         every repo has one; tied to ASP.NET Core 10.0 like Mvc.Testing. -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.1" Optional="true" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="NSubstitute" Version="6.0.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>
</Project>
