{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "categories", "score", "tier", "minimums_applied"],
  "properties": {
    "summary": { "type": "string", "description": "One or two sentences on what drives the risk." },
    "categories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alignment", "impact", "verification", "rollback_cost", "error_detection"],
      "properties": {
        "alignment": { "$ref": "#/$defs/category" },
        "impact": { "$ref": "#/$defs/category" },
        "verification": { "$ref": "#/$defs/category" },
        "rollback_cost": { "$ref": "#/$defs/category" },
        "error_detection": { "$ref": "#/$defs/category" }
      }
    },
    "score": { "type": "number" },
    "tier": { "type": "string", "enum": ["low", "medium", "high"] },
    "minimums_applied": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rating", "gaps"],
      "properties": {
        "rating": { "type": "string", "enum": ["low", "medium", "high", "n/a"] },
        "gaps": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
